# Base URL of the backend API, including the /api/v1 prefix.
# Local dev:  http://localhost:5000/api/v1
# Production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Optional — leave blank to keep "Continue with Google" as a disabled/coming-soon button.
# Same OAuth Client ID as the server's GOOGLE_CLIENT_ID (see server/.env.example for how
# to create one) — this is a public identifier, not a secret, so it's safe in a frontend
# build.
VITE_GOOGLE_CLIENT_ID=
