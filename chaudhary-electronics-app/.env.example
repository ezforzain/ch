# Base URL of the backend API, including the /api/v1 prefix.
# Local dev:  http://localhost:5000/api/v1
# Production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Optional — leave any of these blank to keep "Continue with Google" as a disabled/coming-soon
# button (see src/components/auth/GoogleSignInButton.jsx). Firebase is used only to open the
# Google sign-in popup; the resulting Google ID token is verified by the backend's own
# /auth/google endpoint (server/src/controllers/auth.controller.js), which issues this app's
# normal session — Firebase is not a second user database or session store.
#
# Get these from the Firebase Console: create/open a project, then Project settings (gear icon)
# -> General -> "Your apps" -> add a Web app (</> icon) if you haven't yet -> the config values
# are shown right there. None of these are secret — they're meant to ship in the client bundle;
# Firebase's actual access control is the provider/domain settings in its console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
