NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/chaudhary_electronics

# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional — leave blank to keep "Continue with Google" as a disabled/coming-soon button.
# The frontend opens the Google sign-in popup via Firebase Authentication (see
# chaudhary-electronics-app/.env.example's VITE_FIREBASE_* vars); this is the OAuth Client ID
# that verifies the Google ID token that popup produces — it does NOT need to be created
# separately. Once you've enabled the Google sign-in provider in the Firebase Console
# (Authentication -> Sign-in method -> Google -> Enable), Firebase auto-creates it: find it at
# Authentication -> Sign-in method -> Google -> Web SDK configuration -> "Web client ID". Only
# the Client ID is needed here — this flow verifies a Google-issued ID token, it never touches
# a Client Secret.
GOOGLE_CLIENT_ID=

# Optional — leave blank to store uploaded images locally under /server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — leave blank to log password-reset emails to the console instead of sending real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chaudhary Electronics <no-reply@chaudharyelectronics.pk>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Used only by `npm run seed`
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@chaudharyelectronics.pk
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
